<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Analyzer\**" />
    <Compile Remove="Parser\**" />
    <Content Remove="Analyzer\**" />
    <Content Remove="Parser\**" />
    <EmbeddedResource Remove="Analyzer\**" />
    <EmbeddedResource Remove="Parser\**" />
    <None Remove="Analyzer\**" />
    <None Remove="Parser\**" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NVorbis">
      <HintPath>dll\NVorbis.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="model_sleep_bl.onnx" />
    <EmbeddedResource Include="model_sleep_4LSTM_acc.onnx" />
    <EmbeddedResource Include="model_sleep_4LSTM_speed.onnx" />
    <EmbeddedResource Include="tagging_model.onnx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Analyzer\beatleader-analyzer\Analyzer.csproj" />
    <ProjectReference Include="Analyzer\Parser\beatleader-parser\Parser.csproj" />
  </ItemGroup>

</Project>
