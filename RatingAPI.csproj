  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Analyzer\beatleader-analyzer\Analyzer.csproj" />
    <ProjectReference Include="Analyzer\Parser\beatleader-parser\Parser.csproj" />
  </ItemGroup>

</Project>
