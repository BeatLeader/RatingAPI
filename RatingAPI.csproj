<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Analyzer\**" />
    <Compile Remove="beatleader-analyzer\**" />
    <Compile Remove="Parser\**" />
    <Content Remove="Analyzer\**" />
    <Content Remove="beatleader-analyzer\**" />
    <Content Remove="Parser\**" />
    <EmbeddedResource Remove="Analyzer\**" />
    <EmbeddedResource Remove="beatleader-analyzer\**" />
    <EmbeddedResource Remove="Parser\**" />
    <None Remove="Analyzer\**" />
    <None Remove="beatleader-analyzer\**" />
    <None Remove="Parser\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="model_sleep_bl_replays_sf.csv" />
    <None Remove="model_sleep_bl_replays_sf_njs-30.csv" />
    <None Remove="model_sleep_bl_replays_sf_njs-30_vs_nomods.csv" />
    <None Remove="model_sleep_bl_replays_sf_njs-base.csv" />
    <None Remove="model_sleep_bl_replays_sf_njs-base_vs_nomods.csv" />
    <None Remove="model_sleep_bl_replays_sf_vs_nomods.csv" />
